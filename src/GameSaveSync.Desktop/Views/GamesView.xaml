<UserControl x:Class="GameSaveSync.Desktop.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,6">
            <Button Content="添加游戏" Command="{Binding AddGameCommand}" Padding="10,3" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            <Button Content="从仓库绑定已有游戏" Command="{Binding BindFromRepoCommand}" Padding="10,3" Margin="0,0,8,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            <Button Content="刷新" Command="{Binding LoadGamesCommand}" Padding="10,3" Margin="0,0,8,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            <Button Content="刷新状态" Command="{Binding RefreshStatusCommand}" Padding="10,3" Margin="0,0,8,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            <Button Content="导出时长" Command="{Binding ExportPlaytimeCommand}" Padding="10,3" Margin="0,0,12,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            <CheckBox Content="显示已隐藏" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ProgressBar Width="80" Height="12" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource ThemeMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="10,0,10,6" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="11"
                   Text="右键点击游戏行可 编辑 / 隐藏 / 删除；鼠标悬停可查看存档目录等完整配置。"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView Grid.Row="0" ItemsSource="{Binding Games}" Margin="8,4,8,4"
                      SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource AppListViewItemStyle}">
                    <Setter Property="ToolTip" Value="{Binding DetailText}"/>
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="编辑…"
                                          Command="{Binding PlacementTarget.Tag.EditGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.HideActionText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Command="{Binding PlacementTarget.Tag.ToggleHideCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="删除…"
                                          IsEnabled="{Binding PlacementTarget.DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Command="{Binding PlacementTarget.Tag.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="游戏名称" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeNameBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeStatusIdleBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="已隐藏" FontSize="10" VerticalAlignment="Center" Margin="6,1,0,0"
                                               Foreground="{DynamicResource ThemeStatusIdleBrush}"
                                               Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="未设置存档目录" FontSize="10" VerticalAlignment="Center" Margin="6,1,0,0"
                                               Foreground="{DynamicResource ThemeMutedBrush}"
                                               Visibility="{Binding HasNoSavePath, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="状态" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PillBadgeBorderStyle}">
                                            <Setter Property="Background" Value="{DynamicResource ThemeIdleBadgeBackgroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeRunningBadgeBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeIdleBadgeForegroundBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeStatusRunningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="游戏时长" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlaytimeText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ThemeSecondaryBrush}"
                                           ToolTip="{Binding PlaytimeDetailText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="操作" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Padding="10,2" MinWidth="76"
                                        IsEnabled="{Binding CanToggleLaunch}"
                                        Command="{Binding DataContext.ToggleLaunchCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding LaunchIconText}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LaunchActionText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            </ListView>

            <!-- 选中游戏的最近游戏记录（少于 1 分钟的会话不计入统计） -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="8,4,8,8" Padding="12,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="最近游戏记录"
                               Style="{StaticResource SectionTitleTextBlockStyle}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedSessionsHint}" FontSize="11"
                               Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis"/>
                    <ListView ItemsSource="{Binding RecentSessions}" MaxHeight="150"
                              BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource AppListViewItemStyle}">
                                <Setter Property="MinHeight" Value="26"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="开始时间" Width="170"
                                                DisplayMemberBinding="{Binding StartDisplay}"/>
                                <GridViewColumn Header="结束时间" Width="170"
                                                DisplayMemberBinding="{Binding EndDisplay}"/>
                                <GridViewColumn Header="时长" Width="110"
                                                DisplayMemberBinding="{Binding DurationDisplay}"/>
                                <GridViewColumn Header="结束原因" Width="160"
                                                DisplayMemberBinding="{Binding ReasonDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
