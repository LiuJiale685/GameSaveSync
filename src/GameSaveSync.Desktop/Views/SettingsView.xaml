<UserControl x:Class="GameSaveSync.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="80" Height="12" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 仓库目录绑定 -->
            <GroupBox Header="仓库目录（网盘同步目录下的 GameSaveVault）" Margin="0,10,0,0">
                <StackPanel Margin="8">
                    <TextBlock Text="{Binding BoundRepoPath, StringFormat=当前绑定：{0}}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox Text="{Binding RepoPathInput, UpdateSourceTrigger=PropertyChanged}" Width="400" VerticalAlignment="Center"/>
                        <Button Content="浏览…" Command="{Binding BrowseRepoCommand}" Margin="6,0,0,0" Padding="10,3"/>
                        <Button Content="绑定仓库" Command="{Binding BindRepoCommand}" Margin="6,0,0,0" Padding="10,3"/>
                        <Button Content="迁移仓库到新目录…" Command="{Binding MigrateRepoCommand}" Margin="6,0,0,0" Padding="10,3"/>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="更换网盘同步目录时请用“迁移仓库到新目录…”：会把全部历史版本复制并校验到新目录后自动切换绑定。直接“绑定”到另一个目录会连接到空仓库，导致历史版本丢失。"/>
                </StackPanel>
            </GroupBox>

            <!-- 设备信息 -->
            <GroupBox Header="设备信息" Margin="0,10,0,0">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="设备 ID（前 8 位）：" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceIdShort}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="设备名：" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceName}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="创建时间：" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceCreatedAt}"/>
                    </Grid>
                    <Button Content="重新生成设备 ID" Command="{Binding RegenerateDeviceIdCommand}"
                            Margin="0,8,0,0" Padding="10,3" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <!-- 仓库统计 -->
            <GroupBox Header="仓库统计" Margin="0,10,0,0">
                <StackPanel Margin="8" Orientation="Horizontal">
                    <TextBlock Text="{Binding ObjectCountDisplay, StringFormat=对象数：{0}}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalSizeDisplay, StringFormat=总体积：{0}}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    <Button Content="刷新统计" Command="{Binding RefreshStatsCommand}" Margin="24,0,0,0" Padding="10,3"/>
                </StackPanel>
            </GroupBox>

            <!-- 开机自启动 -->
            <GroupBox Header="启动" Margin="0,10,0,0">
                <CheckBox Content="开机自动启动（写入注册表 HKCU\Software\Microsoft\Windows\CurrentVersion\Run）"
                          IsChecked="{Binding AutoStartEnabled}" Margin="8"/>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
