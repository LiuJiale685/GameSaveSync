<Window x:Class="GameSaveSync.Desktop.Views.Dialogs.PickItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请选择"
        Icon="pack://application:,,,/Assets/GameSaveSync.ico"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ListBox x:Name="ItemList" Height="180" MouseDoubleClick="ItemList_MouseDoubleClick"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Padding="14,4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="取消" Padding="14,4" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
