<Window x:Class="GameSaveSync.Desktop.Views.Dialogs.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加游戏"
        Icon="pack://application:,,,/Assets/GameSaveSync.ico"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ModeText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   TextWrapping="Wrap" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,0,0,10"/>

        <StackPanel x:Name="SharedPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="仓库共享游戏：" VerticalAlignment="Center"/>
            <ComboBox x:Name="SharedCombo" Width="300" Margin="6,0,0,0"
                      SelectionChanged="SharedCombo_SelectionChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="游戏名称：" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="存档目录：" VerticalAlignment="Center" Margin="0,10,8,0"/>
        <TextBox x:Name="PathBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"/>
        <Button Grid.Row="3" Grid.Column="2" Content="浏览…" Margin="6,10,0,0" Padding="8,2"
                VerticalAlignment="Center" Click="Browse_Click"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="进程名：" VerticalAlignment="Center" Margin="0,10,8,0"
                   ToolTip="可选。用于判断游戏是否运行（游戏退出后自动备份）。进程名会同步到共享仓库，供其他设备使用。"/>
        <TextBox x:Name="ProcessBox" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0"
                 ToolTip="可选。多个进程名用逗号或分号分隔，例如：game.exe, launcher.exe（自动补全 .exe 后缀）"/>
        <Button Grid.Row="4" Grid.Column="2" Content="自动识别" Margin="6,10,0,0" Padding="8,2"
                VerticalAlignment="Center" Click="DetectProcess_Click"
                ToolTip="先启动游戏，再点此按钮，从正在运行的进程中自动识别（推荐配置好游戏程序后使用）"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="游戏程序：" VerticalAlignment="Center" Margin="0,10,8,0"
                   ToolTip="可选。选择游戏可执行文件（.exe），之后可在游戏列表一键启动游戏。"/>
        <TextBox x:Name="ExeBox" Grid.Row="5" Grid.Column="1" Margin="0,10,0,0"
                 ToolTip="可选。游戏可执行文件完整路径，例如 D:\Games\MyGame\MyGame.exe"/>
        <Button Grid.Row="5" Grid.Column="2" Content="浏览…" Margin="6,10,0,0" Padding="8,2"
                VerticalAlignment="Center" Click="BrowseExe_Click"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="{DynamicResource ThemeMutedBrush}"
                   TextWrapping="Wrap"
                   Text="进程名统一保存为 name.exe 格式（可只填 name，会自动补全），并随仓库同步到其他设备；配置游戏程序后可在列表中启动/停止游戏。"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Padding="14,4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="取消" Padding="14,4" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
