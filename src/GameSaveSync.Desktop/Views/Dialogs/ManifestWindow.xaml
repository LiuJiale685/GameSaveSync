<Window x:Class="GameSaveSync.Desktop.Views.Dialogs.ManifestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件清单"
        Icon="pack://application:,,,/Assets/GameSaveSync.ico"
        Width="760" Height="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button DockPanel.Dock="Bottom" Content="关闭" IsCancel="True" HorizontalAlignment="Right"
                Padding="14,4" Margin="0,10,0,0"/>
        <ListView x:Name="FileList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件路径" DisplayMemberBinding="{Binding FilePath}" Width="500"/>
                    <GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeText}" Width="140"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
