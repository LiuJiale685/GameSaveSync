<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题配色（与 LightTheme.xaml 保持相同 Key） -->
    <SolidColorBrush x:Key="ThemeMutedBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="ThemeSecondaryBrush" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="ThemeNameBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ThemeStatusRunningBrush" Color="#6BCB77"/>
    <SolidColorBrush x:Key="ThemeStatusIdleBrush" Color="#8A8A8A"/>

    <!-- 语义色（与 LightTheme.xaml 保持相同 Key） -->
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="ThemeAccentForegroundBrush" Color="#003A5D"/>
    <SolidColorBrush x:Key="ThemeDangerBrush" Color="#D13438"/>
    <SolidColorBrush x:Key="ThemeDangerForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="#E8A33D"/>
    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ThemeHashBadgeBackgroundBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ThemeHashBadgeForegroundBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ThemeRunningBadgeBackgroundBrush" Color="#1E3324"/>
    <SolidColorBrush x:Key="ThemeIdleBadgeBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ThemeIdleBadgeForegroundBrush" Color="#A0A0A0"/>

    <!-- 列表行背景（悬停 / 选中），保证浅色文字始终有足够对比度 -->
    <SolidColorBrush x:Key="ThemeRowHoverBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ThemeRowSelectedBrush" Color="#1F3A4D"/>
    <SolidColorBrush x:Key="ThemeRowSelectedHoverBrush" Color="#28495F"/>

    <!-- 游戏库：左侧列表底色 + 右侧详情区底色 + 顶部横幅渐变 -->
    <SolidColorBrush x:Key="ThemeSidebarBackgroundBrush" Color="#1B1B1D"/>
    <SolidColorBrush x:Key="ThemeDetailBackgroundBrush" Color="#232325"/>
    <LinearGradientBrush x:Key="ThemeHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1F3A4D" Offset="0"/>
        <GradientStop Color="#2A2A2A" Offset="0.65"/>
        <GradientStop Color="#1B1B1D" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
