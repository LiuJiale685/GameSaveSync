<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GameSaveSync.ico</ApplicationIcon>
    <AssemblyName>GameSaveSync</AssemblyName>

    <!-- 程序集与文件版本信息（资源管理器属性、自动更新比对使用） -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>Jiale</Company>
    <Authors>Jiale</Authors>
    <Product>GameSaveSync</Product>
    <AssemblyTitle>GameSaveSync (By Jiale)</AssemblyTitle>
    <Description>本地单机游戏存档同步工具 — By Jiale</Description>
    <Copyright>Copyright © 2026 Jiale</Copyright>

    <!-- 发布默认值：自包含（目标机器无需安装 .NET）。
         注意：不要启用 PublishSingleFile —— WPF + 自包含单文件在本项目实测会启动即静默退出；
         WPF 对 IL 裁剪支持也不完善，故显式关闭 Trim 与 ReadyToRun。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 启用 .NET 10 WPF 内置 Fluent 深浅色主题（Application.ThemeMode 仍标记为实验性）。 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 应用图标资源：exe 图标由 ApplicationIcon 嵌入，窗口/托盘/安装包复用同一文件 -->
    <Resource Include="Assets\GameSaveSync.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameSaveSync.Core\GameSaveSync.Core.csproj" />
    <ProjectReference Include="..\GameSaveSync.Storage\GameSaveSync.Storage.csproj" />
    <ProjectReference Include="..\GameSaveSync.FileSystem\GameSaveSync.FileSystem.csproj" />
    <ProjectReference Include="..\GameSaveSync.Snapshot\GameSaveSync.Snapshot.csproj" />
    <ProjectReference Include="..\GameSaveSync.Sync\GameSaveSync.Sync.csproj" />
    <ProjectReference Include="..\GameSaveSync.Data\GameSaveSync.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
